# ── App ───────────────────────────────────────────────────────────────
APP_HOST=127.0.0.1            # bind address; keep loopback behind nginx
APP_PORT=3060
APP_ENV=production
APP_NAME=haskell-api-monitor

# ── Database ──────────────────────────────────────────────────────────
DB_BACKEND=postgresql
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/DBNAME
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=haskell_monitor
DB_USER=haskell_monitor_user
DB_PASSWORD=change_me

# ── Paths ─────────────────────────────────────────────────────────────
LOG_DIR=./logs
DATA_DIR=./data

# ── Checker / Scheduler ───────────────────────────────────────────────
ALLOW_PRIVATE_TARGETS=false   # true only for local testing; enables SSRF to private IPs
MAX_RESPONSE_BYTES=1048576     # cap on fetched response body (bytes) to avoid OOM
DEFAULT_TIMEOUT_SECONDS=10
DEFAULT_CHECK_INTERVAL_SECONDS=60
MAX_CONCURRENT_CHECKS=4

# ── Auth (HTTP Basic over the whole app) ──────────────────────────────
APP_BASIC_AUTH_ENABLED=false
APP_USERNAME=admin
APP_PASSWORD=change_me_too
