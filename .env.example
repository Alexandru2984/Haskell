# Haskell Pulse. Only variables consumed by the application are listed here.
APP_HOST=127.0.0.1
APP_PORT=3060
APP_ENV=production
# Exact browser origin, without trailing slash. Required for form submissions.
APP_ORIGIN=https://haskell.micutu.com

DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/DBNAME

# Authentication is mandatory in production. Use a unique password (16+ chars).
APP_BASIC_AUTH_ENABLED=true
APP_USERNAME=admin
APP_PASSWORD=replace_with_a_unique_password_at_least_16_characters

# Private targets and disabled authentication require APP_ENV=development.
ALLOW_PRIVATE_TARGETS=false
MAX_RESPONSE_BYTES=1048576
DEFAULT_TIMEOUT_SECONDS=10
DEFAULT_CHECK_INTERVAL_SECONDS=60
MAX_CONCURRENT_CHECKS=4
MAX_ENDPOINTS=200
# 0 disables pruning. Set 1..365 only after choosing a history retention policy.
RETENTION_DAYS=0
